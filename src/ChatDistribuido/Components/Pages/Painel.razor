@page "/"
@rendermode InteractiveServer
@inject NodeService Node
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Nó @Node.State.Id — Chat Distribuído</PageTitle>

<nav class="topnav">
    <span class="brand"><span class="dot"></span>Chat Distribuído</span>
    <span class="spacer"></span>
    <span class="badge lead"><span class="led"></span><span class="k">líder</span>
        <span class="v">@(Node.State.LiderAtual?.ToString() ?? "—")</span></span>
    @if (Node.State.EmEleicao)
    {
        <span class="badge warn"><span class="led"></span><span class="v">eleição</span></span>
    }
    <span class="node-chip">nó @Node.State.Id</span>
</nav>

<div class="chat-layout">
    <aside class="conv-list">
        <p class="conv-title">Conversas</p>
        <button class="conv-item @(IsGrupo ? "active" : "")" @onclick='() => Selecionar("grupo")'>
            <span class="conv-avatar grupo">#</span>
            <span class="conv-name">Grupo</span>
            @if (NaoLida("grupo")) { <span class="unread-dot"></span> }
        </button>
        @foreach (var peer in Node.OutrosNos)
        {
            var chave = $"pv{peer}";
            <button class="conv-item @(_ativo == chave ? "active" : "")" @onclick="() => Selecionar(chave)">
                <span class="conv-avatar">@peer</span>
                <span class="conv-name">Nó @peer</span>
                @if (NaoLida(chave)) { <span class="unread-dot"></span> }
            </button>
        }
    </aside>

    <main class="chat-main">
        <header class="chat-head">
            <h1>@(IsGrupo ? "Grupo" : $"Nó {PeerAtivo}")</h1>
            <span class="chat-sub">
                @(IsGrupo ? "Difusão em ordem total para todos os nós" : "Conversa privada (unicast)")
            </span>
        </header>

        <div class="messages" id="messages">
            @if (Mensagens().Count == 0)
            {
                <p class="empty center">Nenhuma mensagem ainda. Escreva algo abaixo.</p>
            }
            else
            {
                @foreach (var m in Mensagens())
                {
                    <div class="bubble-row @(m.Propria ? "me" : "them")">
                        <div class="bubble @(m.Propria ? "me" : "them")">
                            @if (!m.Propria)
                            {
                                <span class="who">@m.Autor</span>
                            }
                            <span class="text">@m.Texto</span>
                            <span class="meta">@m.Meta</span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="composer">
            <input class="grow" placeholder="@(IsGrupo ? "Mensagem para o grupo" : $"Mensagem para o nó {PeerAtivo}")"
                   @bind="_texto" @bind:event="oninput" @onkeydown="OnKey" />
            <button class="btn-primary" @onclick="Enviar">Enviar</button>
        </div>
    </main>
</div>

<details class="tech-drawer">
    <summary>Observação técnica do nó</summary>
    <div class="tech-grid">
        <div class="tech-card">
            <h3>Relógio vetorial</h3>
            <p class="mono big">[@string.Join(",", Node.State.Vc)]</p>
            <h3>Buffer (seqs pendentes)</h3>
            <p class="mono">@(Node.State.BufferSeqs.Count == 0 ? "vazio" : string.Join(", ", Node.State.BufferSeqs))</p>
            <button class="btn-secondary" @onclick="() => Node.DispararSnapshot()">Capturar estado global</button>
        </div>
        <div class="tech-card">
            <h3>Ordem local de emissão <span class="count">@Node.State.OrdemLocal().Count</span></h3>
            @{ var locais = Node.State.OrdemLocal(); }
            @if (locais.Count == 0)
            {
                <p class="empty">Nenhuma emissão.</p>
            }
            else
            {
                <ul class="log">
                    @foreach (var e in locais)
                    {
                        <li><span class="seq">#@e.Ordem</span><span>@e.Descricao</span><span class="mono">@e.Vc</span></li>
                    }
                </ul>
            }
        </div>
        <div class="tech-card wide">
            <h3>Estado global capturado</h3>
            <pre class="snap">@(Node.State.UltimoSnapshot ?? "Nenhum snapshot capturado ainda.")</pre>
        </div>
    </div>
</details>

@code {
    private string _ativo = "grupo";
    private string _texto = "";
    private readonly Dictionary<string, int> _visto = new();
    private readonly HashSet<string> _naoLida = new();
    private int _ultimaContagemAtiva = -1;

    private bool IsGrupo => _ativo == "grupo";
    private int PeerAtivo => int.Parse(_ativo[2..]); // "pv{peer}"

    private sealed record Balao(bool Propria, string Autor, string Texto, string Meta);

    protected override void OnInitialized()
    {
        Node.State.Changed += OnChanged;
        SincronizarVisto(); // conta o estado inicial como já visto
    }

    private void OnChanged()
    {
        AtualizarNaoLida();
        InvokeAsync(StateHasChanged);
    }

    private List<Balao> Mensagens()
    {
        if (IsGrupo)
        {
            return Node.State.OrdemGlobal()
                .Select(g => new Balao(
                    g.DeOriginal == Node.State.Id,
                    g.DeOriginal == Node.State.Id ? "você" : $"Nó {g.DeOriginal}",
                    g.Conteudo, g.Vc))
                .ToList();
        }
        var peer = PeerAtivo;
        return Node.State.PrivadasCom(peer)
            .Select(p => new Balao(
                p.Enviada,
                p.Enviada ? "você" : $"Nó {p.De}",
                p.Conteudo, p.Vc))
            .ToList();
    }

    private int Contagem(string chave) =>
        chave == "grupo"
            ? Node.State.OrdemGlobal().Count
            : Node.State.PrivadasCom(int.Parse(chave[2..])).Count;

    private IEnumerable<string> TodasConversas()
    {
        yield return "grupo";
        foreach (var peer in Node.OutrosNos) yield return $"pv{peer}";
    }

    private void SincronizarVisto()
    {
        foreach (var c in TodasConversas()) _visto[c] = Contagem(c);
    }

    private void AtualizarNaoLida()
    {
        foreach (var c in TodasConversas())
        {
            var atual = Contagem(c);
            if (c == _ativo)
            {
                _visto[c] = atual;
                _naoLida.Remove(c);
            }
            else if (atual > _visto.GetValueOrDefault(c))
            {
                _naoLida.Add(c);
            }
        }
    }

    private bool NaoLida(string chave) => _naoLida.Contains(chave);

    private void Selecionar(string chave)
    {
        _ativo = chave;
        _visto[chave] = Contagem(chave);
        _naoLida.Remove(chave);
        _ultimaContagemAtiva = -1; // força rolagem ao trocar de conversa
    }

    private void Enviar()
    {
        if (string.IsNullOrWhiteSpace(_texto)) return;
        if (IsGrupo) Node.EnviarGrupo(_texto);
        else Node.EnviarUnicast(PeerAtivo, _texto); // PV nunca é o próprio nó (lista só tem OutrosNos)
        _texto = "";
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Enviar();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var atual = Mensagens().Count;
        if (atual != _ultimaContagemAtiva)
        {
            _ultimaContagemAtiva = atual;
            await JS.InvokeVoidAsync("rolarParaFim", "messages");
        }
    }

    public void Dispose() => Node.State.Changed -= OnChanged;
}
