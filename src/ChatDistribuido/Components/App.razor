<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Chat Distribuído</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />

    <!-- Modal de reconexão do Blazor Server (estilizado para o tema escuro; o framework
         alterna as classes components-reconnect-* neste elemento). -->
    <div id="components-reconnect-modal" data-nosnippet>
        <div class="reconnect-box" role="alertdialog" aria-live="assertive">
            <p class="reconnect-title">Conexão perdida</p>
            <p class="reconnect-text reconnect-retrying">Tentando reconectar ao servidor…</p>
            <p class="reconnect-text reconnect-failed">Falha ao reconectar. Tentando novamente…</p>
            <p class="reconnect-text reconnect-rejected">
                Não foi possível reconectar. <a href="" class="reload">Recarregar a página</a>.
            </p>
        </div>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script>
        window.rolarParaFim = (id) => {
            const el = document.getElementById(id);
            if (el) el.scrollTop = el.scrollHeight;
        };
    </script>
</body>
</html>
